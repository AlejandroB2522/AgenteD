# Copia este archivo como  .env  y rellena tu clave real.
# El archivo .env NO se comparte ni se sube a ningún lado.

# Clave de la API de Claude (se obtiene en https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar. Opciones recomendadas:
#   claude-haiku-5-5    -> el más barato
#   claude-sonnet-5-5   -> equilibrio (por defecto)
#   claude-opus-5-5     -> el más capaz
MODELO_CLAUDE=claude-sonnet-5-5
